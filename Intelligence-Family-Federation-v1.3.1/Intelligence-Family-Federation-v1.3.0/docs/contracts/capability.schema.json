{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelligence-family.github.io/schemas/capability.schema.json",
  "title": "Intelligence Family Capability Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "risk_class", "providers"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "risk_class": {"type": "string", "enum": ["informational", "assistive", "consequential"]},
    "providers": {"type": "array", "items": {"type": "string"}},
    "human_approval_required": {"type": "boolean"},
    "test_requirements": {"type": "array", "items": {"type": "string"}}
  }
}
